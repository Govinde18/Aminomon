@echo off
setlocal EnableExtensions
title Aminomon
chcp 65001 >nul
set "PYTHONUTF8=1"
set "APP=%LOCALAPPDATA%\Aminomon"
set "SELF=%~f0"
set "BUILD=cac0f64dec5a"

if /i "%~1"=="--uninstall" goto :uninstall

rem ---------------------------------------------------------------
rem  1. Find Python 3.9+ (py launcher first, then python on PATH)
rem ---------------------------------------------------------------
set "PY="
py -3 -c "import sys; sys.exit(0 if sys.version_info>=(3,9) else 1)" >nul 2>&1
if not errorlevel 1 set "PY=py -3"
if defined PY goto :havepy
python -c "import sys; sys.exit(0 if sys.version_info>=(3,9) else 1)" >nul 2>&1
if not errorlevel 1 set "PY=python"
if defined PY goto :havepy
goto :nopython

:havepy

rem ---------------------------------------------------------------
rem  2. Unpack the game (first run, or when this file is newer)
rem ---------------------------------------------------------------
set "CUR="
if exist "%APP%\game\.build" set /p CUR=<"%APP%\game\.build"
if "%CUR%"=="%BUILD%" if exist "%APP%\game\aminomon.py" goto :unpacked

echo.
echo  Unpacking Aminomon...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $l=[IO.File]::ReadAllLines($env:SELF); $i=[Array]::IndexOf($l,'::PAYLOAD'); $b=[string]::Join('',$l[($i+1)..($l.Length-1)]); $d=Join-Path $env:APP 'game'; $z=Join-Path $env:APP 'game.zip'; New-Item -ItemType Directory -Force $env:APP | Out-Null; [IO.File]::WriteAllBytes($z,[Convert]::FromBase64String($b)); if(Test-Path $d){Remove-Item -Recurse -Force $d}; Add-Type -AssemblyName System.IO.Compression.FileSystem; [IO.Compression.ZipFile]::ExtractToDirectory($z,$d); Remove-Item $z"
if errorlevel 1 goto :unpackfail
if not exist "%APP%\game\aminomon.py" goto :unpackfail
>"%APP%\game\.build" echo %BUILD%

:unpacked

rem ---------------------------------------------------------------
rem  3. Make sure the curses library exists (Windows needs a pip package)
rem ---------------------------------------------------------------
%PY% -c "import curses" >nul 2>&1
if not errorlevel 1 goto :cursesok
echo.
echo  Installing windows-curses, first run only...
%PY% -m pip install --disable-pip-version-check --user windows-curses
if errorlevel 1 goto :cursesfail
:cursesok

rem ---------------------------------------------------------------
rem  4. Play
rem ---------------------------------------------------------------
cd /d "%APP%\game"
mode con cols=100 lines=36 >nul 2>&1
%PY% aminomon.py --sin-actualizar %*
set "RC=%ERRORLEVEL%"
if "%RC%"=="0" exit /b 0
echo.
echo  Aminomon closed with an error, code %RC%.
pause
exit /b %RC%

:nopython
echo.
echo  Python 3.9 or newer was not found on this computer.
where winget >nul 2>&1
if errorlevel 1 goto :manualpy
echo  Aminomon can install Python 3.12 for you using winget.
choice /c YN /m "Install Python now"
if errorlevel 2 goto :manualpy
winget install -e --id Python.Python.3.12 --accept-package-agreements --accept-source-agreements
if errorlevel 1 goto :manualpy
echo.
echo  Python is installed. Close this window and open this file again.
pause
exit /b 0

:manualpy
echo.
echo  Please install Python from https://www.python.org/downloads/
echo  and tick "Add python.exe to PATH" in the installer.
echo  Then open this file again.
start "" "https://www.python.org/downloads/"
pause
exit /b 1

:unpackfail
echo.
echo  Could not unpack the game into %APP%
echo  Make sure this file was fully downloaded and PowerShell is available.
pause
exit /b 1

:cursesfail
echo.
echo  Could not install windows-curses. Check your internet connection and try:
echo      %PY% -m pip install windows-curses
echo  If your Python is very new, Python 3.12 is the safest choice.
pause
exit /b 1

:uninstall
if exist "%APP%" rmdir /s /q "%APP%"
echo  Aminomon files removed.
echo  Your saved game was kept at %USERPROFILE%\.aminomon.json
pause
exit /b 0

